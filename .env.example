DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_attendance
JWT_SECRET=change-me-to-a-long-random-string

# optional (defaults shown)
PORT=3001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# comma separated frontend URLs; leave unset to allow any origin in development
# CORS_ORIGIN=http://localhost:5173
# production = JSON logs, anything else = pretty logs (pino-pretty)
# NODE_ENV=production
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# tests use .env.test, which overrides DATABASE_URL (the db name MUST contain "test"):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_attendance_test
